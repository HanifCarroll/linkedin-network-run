{
  "name": "linkedin-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "linkedin-tools": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts --target=bun --outdir=dist && chmod +x ./dist/cli.js",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build",
    "check:cli": "biome check src/cli.ts src/commands tests/cli.test.ts tests/commands scripts/smoke.ts",
    "dev": "bun run ./src/cli.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "smoke": "bun run scripts/smoke.ts",
    "test:cli": "bun test tests/cli.test.ts tests/commands",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwriter": "0.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/bun": "1.3.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
